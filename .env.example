# Copy to .env (`cp .env.example .env`). Every value is optional; the defaults below are used otherwise.

# --- LLM ---------------------------------------------------------------------
# Real Claude: put your key here. Without a key the system still starts, but the
# LLM endpoints answer 503 llm_not_configured and the UI shows a red banner.
# There is no silent fallback to the mock.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_SEGMENT=claude-sonnet-5-5
ANTHROPIC_MODEL_CONTENT=claude-sonnet-5-5
# Optional: also ask Claude whether earlier campaigns sent to the same people
# in the last 30 days had the same purpose (different wording). Off by default.
DUPLICATE_LLM_CHECK=false

# anthropic | mock
# mock = deterministic fixtures, ONLY for demos/development without a key. The UI
# shows a permanent orange "MOCK MOD" banner and campaigns are marked llm_provider=mock.
LLM_PROVIDER=anthropic

# --- Sending -----------------------------------------------------------------
# Does the provider honour Idempotency-Key? true: ambiguous failures (5xx/timeout)
# are retried with the same key. false: they become 'unknown' and are never retried.
PROVIDER_IDEMPOTENCY=true

# --- Mock provider fault injection (rates are probabilities per request) -------
MOCK_FAIL_RATE=0.05            # 503, nothing delivered
MOCK_429_RATE=0.03             # random 429 with Retry-After, nothing delivered
MOCK_LOST_RESPONSE_RATE=0.02   # delivered, then 502 (response "lost")
MOCK_TIMEOUT_RATE=0.01         # delivered, then hangs MOCK_TIMEOUT_DELAY_MS and returns 504
MOCK_LATENCY_MIN_MS=10
MOCK_LATENCY_MAX_MS=150
MOCK_TIMEOUT_DELAY_MS=10000
MOCK_RATE_PER_SECOND=100       # per channel, trailing 1s window; exceeding it -> 429
MOCK_IDEMPOTENCY=true          # false: a repeated Idempotency-Key is delivered again
